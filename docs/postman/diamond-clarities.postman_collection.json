{
  "info": {
    "name": "Diamond Clarities API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    { "name": "List Diamond Clarities", "request": { "method": "GET", "url": "{{baseUrl}}/api/diamond-clarities" } },
    { "name": "Create Diamond Clarity", "request": { "method": "POST", "url": "{{baseUrl}}/api/diamond-clarities", "body": { "mode": "raw", "raw": "{\"name\": \"Sample Diamond Clarity\"}" } } },
    { "name": "Show Diamond Clarity", "request": { "method": "GET", "url": "{{baseUrl}}/api/diamond-clarities/1" } },
    { "name": "Update Diamond Clarity", "request": { "method": "PUT", "url": "{{baseUrl}}/api/diamond-clarities/1", "body": { "mode": "raw", "raw": "{\"name\": \"Updated Diamond Clarity\"}" } } },
    { "name": "Delete Diamond Clarity", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/diamond-clarities/1" } }
  ],
  "variable": [{ "key": "baseUrl", "value": "http://localhost:8000" }]
}
